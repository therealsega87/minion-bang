{
  "id": "minion-bang",
  "title": "Minion!",
  "description": "Automates the Minion trait and overkill rules for D&D 5e, integrated with Midi-QOL: minions die at 0 HP as they should, and a weapon attack that overkills a minion lets you pick which nearby minions fall with it, right on the map.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14.368"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.2",
          "verified": "5.3.3",
          "maximum": "5.3.99"
        }
      }
    ],
    "requires": [
      {
        "id": "socketlib",
        "type": "module"
      },
      {
        "id": "midi-qol",
        "type": "module",
        "compatibility": {
          "minimum": "14.0.11"
        },
        "reason": "Minion! reads Midi-QOL's damage calculation to apply the Minion trait and detect overkill."
      }
    ]
  },
  "socket": true,
